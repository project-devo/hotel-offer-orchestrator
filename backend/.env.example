# Copy to .env (never commit it). All values below are the defaults.
NODE_ENV=development
PORT=3000
# api | worker | all  (all = HTTP server first, then the Temporal worker)
APP_MODE=all
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Set for Temporal Cloud (enables TLS + API key auth), e.g. TEMPORAL_ADDRESS=<region>.<cloud>.api.temporal.io:7233
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=hotel-offers
# true = docker-entrypoint.sh starts a Temporal dev server inside the container
EMBEDDED_TEMPORAL=false

# Where activities and /health call the mock suppliers (defaults to http://127.0.0.1:$PORT)
SUPPLIER_BASE_URL=
SUPPLIER_TIMEOUT_MS=3000
SUPPLIER_LATENCY_MS=100

CACHE_TTL_SECONDS=600
PARTIAL_CACHE_TTL_SECONDS=60
SUPPLIER_DOWN_TTL_SECONDS=300

# Comma-separated; https://hotel-offer-orchestrator*.vercel.app is always allowed
CORS_ORIGINS=http://localhost:5173
