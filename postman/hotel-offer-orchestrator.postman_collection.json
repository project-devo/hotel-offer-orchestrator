    {
      "name": "04 Best offers - delhi (overlaps)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const hotels = pm.response.json();",
              "pm.test('response is an array of hotels with exactly 4 keys', () => {",
              "  pm.expect(hotels).to.be.an('array');",
              "  hotels.forEach((h) => pm.expect(Object.keys(h).sort()).to.eql(['commissionPct', 'name', 'price', 'supplier']));",
              "});",
              "pm.test('9 de-duplicated hotels', () => pm.expect(hotels).to.have.lengthOf(9));",
              "pm.test('hotel names are unique (case-insensitive)', () => {",
              "  const names = hotels.map((h) => h.name.trim().toLowerCase());",
              "  pm.expect(new Set(names).size).to.eql(names.length);",
              "});",
              "pm.test('Holtin: Supplier B at 5340 (B cheaper)', () => {",
              "  pm.expect(hotels.find((h) => h.name === 'Holtin')).to.eql({ name: 'Holtin', price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
              "});",
              "pm.test('Radison: Supplier A at 5900 (A cheaper)', () => {",
              "  pm.expect(hotels.find((h) => h.name === 'Radison')).to.eql({ name: 'Radison', price: 5900, supplier: 'Supplier A', commissionPct: 13 });",
              "});",
              "pm.test('sorted by price ascending', () => {",
              "  hotels.slice(1).forEach((h, i) => pm.expect(h.price).to.be.at.least(hotels[i].price));",
              "});",
              "pm.test('X-Workflow-Id header present', () => pm.response.to.have.header('X-Workflow-Id'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            }
          ]
        },
        "description": "Runs the Temporal workflow: both suppliers in parallel, de-duplicated by name, cheapest offer per hotel. Also refreshes the Redis cache."
      }
    },
    {
      "name": "05 Price filter 4000-7000 (Redis)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const hotels = pm.response.json();",
              "pm.test('response is an array of hotels with exactly 4 keys', () => {",
              "  pm.expect(hotels).to.be.an('array');",
              "  hotels.forEach((h) => pm.expect(Object.keys(h).sort()).to.eql(['commissionPct', 'name', 'price', 'supplier']));",
              "});",
              "pm.test('exactly Holtin and Radison', () => pm.expect(hotels.map((h) => h.name)).to.eql(['Holtin', 'Radison']));",
              "pm.test('all prices within 4000-7000', () => hotels.forEach((h) => pm.expect(h.price).to.be.within(4000, 7000)));",
              "pm.test('X-Cache header present', () => pm.response.to.have.header('X-Cache'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=4000&maxPrice=7000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            },
            {
              "key": "minPrice",
              "value": "4000"
            },
            {
              "key": "maxPrice",
              "value": "7000"
            }
          ]
        },
        "description": "Filtered inside Redis (Lua: ZRANGE BYSCORE + HMGET). X-Cache is HIT when the city is cached, MISS when the workflow had to run first."
      }
    },
